{
  "name": "notifications",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "pm2 start ./build/src/app.js -i 5 --attach --watch | pino-pretty -c",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "dev": "nodemon -r tsconfig-paths/register src/app.ts | pino-pretty -c",
    "lint:check": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier --check 'src/**/*.{ts,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,json}'",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json && ts-node tools/copyAssets.ts",
    "test": "jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/email-templates": "^10.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.0",
    "@vsatya-kirankumar/jobber-shared": "^0.0.4",
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "email-templates": "^13.0.1",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "http-status-codes": "^2.3.0",
    "nodemailer": "^8.0.10",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "shelljs": "^0.10.0",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "winston": "^3.19.0"
  }
}
